# Compose-level configuration. Copy to `.env` in this directory:
#
#   cp .env.docker.example .env
#
# This file holds no secrets — those stay in each services/<name>/.env and are
# read at runtime, never baked into an image.

# Scheme + host the BROWSER uses to reach the stack. Compose appends the port.
#
# Local:   http://localhost
# EC2:     http://<public-ip>   (or https://<domain> behind a proxy)
#
# This is compiled into the frontend bundle at build time, so changing it
# requires a rebuild, not just a restart:
#
#   docker compose up --build -d frontend
#
PUBLIC_HOST=http://localhost
